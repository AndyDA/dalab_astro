---
import Layout from '~/layouts/LandingLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageRenderer from '~/components/tina/PageRenderer.astro';
import { islands } from '~/lib/tina/islands';

import pageJson from '~/data/pages/landing/pre-launch.json';
import { getPage } from '~/lib/tina/data';

const pageJsonData = pageJson as {
  title?: string;
  metadataTitle?: string;
  widgets?: Array<Record<string, any>> | null;
};

const pageResult = await getPage('landing/pre-launch.json').catch(() => null);
const tinaData = pageResult?.data?.page ?? null;
const page = tinaData ?? pageJsonData;

const metadata = {
  title: page.metadataTitle ?? 'Pre-Launch & Coming Soon Landing Page Example & Guide',
  description:
    'A complete pre-launch landing page built with AstroWind: early signup form, what is coming, launch roadmap, honest launch facts, a real teaser and FAQ, with notes on why each block earns the email. Free Astro template.',
  openGraph: { type: 'website' },
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <TinaIsland name="page" wrapper={islands.page.wrapper} params={{ relativePath: 'landing/pre-launch.json' }} primary>
    <PageRenderer widgets={page.widgets as Array<Record<string, any>> | null} />
  </TinaIsland>
</Layout>
