---
import Layout from '~/layouts/PageLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageRenderer from '~/components/tina/PageRenderer.astro';
import { islands } from '~/lib/tina/islands';

import pageJson from '~/data/pages/services.json';
import { getPage } from '~/lib/tina/data';

const pageJsonData = pageJson as {
  title?: string;
  metadataTitle?: string;
  widgets?: Array<Record<string, any>> | null;
};

const pageResult = await getPage('services.json').catch(() => null);
const tinaData = pageResult?.data?.page ?? null;
const page = tinaData ?? pageJsonData;

const metadata = {
  title: page.metadataTitle ?? 'Services',
  description:
    'Services page demo built with AstroWind: showcase what you offer with feature grids, content blocks and testimonials.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <TinaIsland name="page" wrapper={islands.page.wrapper} params={{ relativePath: 'services.json' }} primary>
    <PageRenderer widgets={page.widgets as Array<Record<string, any>> | null} />
  </TinaIsland>
</Layout>
